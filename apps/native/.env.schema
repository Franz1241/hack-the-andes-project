# @type=enum(development, production)
APP_ENV=development

# Inlined into the JS bundle, so it must never hold a secret. On a physical
# device point it at your machine's LAN/Tailscale IP instead of localhost.
# @type=url
EXPO_PUBLIC_SERVER_URL=http://localhost:3000
