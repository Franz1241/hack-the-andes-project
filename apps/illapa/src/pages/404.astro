---
import { buttonVariants } from "@hack-the-andes-project/ui/components/button";
import { IllapaLockup } from "@hack-the-andes-project/ui/components/illapa-logo";
import SiteFooter from "@/components/site-footer.astro";
import Base from "@/layouts/base.astro";
---

<Base title="Página no encontrada | ILLAPA" description="Esta página no existe.">
	<main class="mx-auto flex min-h-svh max-w-7xl flex-col justify-center gap-5 px-5 py-24 sm:px-8">
		<IllapaLockup />
		<p class="type-label text-muted-foreground">404</p>
		<h1 class="type-title max-w-3xl">Esta página no existe.</h1>
		<p class="type-lead max-w-2xl text-muted-foreground">Puede que el enlace esté mal escrito o que la página se haya movido.</p>
		<div class="mt-3">
			<a href="/" class={buttonVariants({ variant: "default", size: "lg" })}>Volver al inicio</a>
		</div>
	</main>
	<SiteFooter />
</Base>
