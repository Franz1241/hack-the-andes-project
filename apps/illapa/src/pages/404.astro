---
import Base from "@/layouts/base.astro";
---

<Base title="Página no encontrada | Illapa" description="Esta página no existe.">
	<main class="mx-auto flex min-h-svh max-w-7xl flex-col justify-center px-5 sm:px-8">
		<h1 class="text-4xl font-semibold">Esta página no existe.</h1>
		<p class="mt-4 text-muted-foreground">
			Puede que el enlace esté mal escrito o que la página se haya movido.
		</p>
		<a href="/" class="mt-8 inline-flex h-11 w-fit items-center bg-foreground px-5 font-medium text-background">
			Volver al inicio
		</a>
	</main>
</Base>
