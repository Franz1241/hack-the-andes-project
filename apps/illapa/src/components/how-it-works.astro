---
interface Step {
	title: string;
	description: string;
}

const steps: Step[] = [
	{
		title: "Carga tu red",
		description:
			"Sube tus rutas, almacenes y puntos de entrega, o conéctalos desde tu TMS. Illapa los convierte en corredores vigilados.",
	},
	{
		title: "Cruzamos cada alerta con tus corredores",
		description:
			"Cuando una fuente publica un aviso, calculamos qué tramos quedan dentro de la zona y qué despachos programados pasan por ahí.",
	},
	{
		title: "Recibes el aviso con lo que necesitas decidir",
		description:
			"Tramo afectado, ventana estimada y la alternativa disponible, por WhatsApp, correo o API, antes de que el camión salga.",
	},
];
---

<section id="como-funciona" class="bg-puna text-puna-foreground">
	<div class="mx-auto max-w-7xl px-5 py-24 sm:px-8 lg:py-32">
		<h2 class="max-w-2xl text-3xl font-semibold sm:text-4xl">
			De un aviso regional a una decisión sobre tu despacho
		</h2>
		<ol class="mt-14 grid gap-10 md:grid-cols-3">
			{
				steps.map((step, index) => (
					<li class="border-t border-puna-foreground/25 pt-5">
						<span class="font-mono text-sm text-puna-foreground/60">{index + 1}</span>
						<h3 class="mt-3 text-xl font-medium">{step.title}</h3>
						<p class="mt-3 text-puna-foreground/75">{step.description}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>
