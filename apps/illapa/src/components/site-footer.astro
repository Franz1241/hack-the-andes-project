---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border">
	<div class="mx-auto flex max-w-7xl flex-col gap-6 px-5 py-8 sm:px-8 lg:flex-row lg:items-end lg:justify-between">
		<div class="flex flex-col gap-3">
			<p class="type-heading">ILLAPA</p>
			<p class="type-body text-muted-foreground">Inteligencia climática para la logística del Perú.</p>
			<p class="type-label text-muted-foreground">Equipo Fénix · Hack the Andes</p>
		</div>
		<p class="type-data text-muted-foreground">Lima, Perú. {currentYear}.</p>
	</div>
</footer>
