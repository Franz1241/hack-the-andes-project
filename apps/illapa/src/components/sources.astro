---
interface Source {
	name: string;
	role: string;
}

const sources: Source[] = [
	{ name: "SENAMHI", role: "avisos meteorológicos e hidrológicos" },
	{ name: "ENFEN", role: "estado del Niño costero" },
	{ name: "INDECI y COEN", role: "emergencias declaradas" },
	{ name: "Provías Nacional", role: "estado de la red vial" },
	{ name: "Sutran", role: "restricciones de tránsito" },
	{ name: "IGP", role: "sismos y actividad volcánica" },
	{ name: "DHN", role: "oleaje y cierre de puertos" },
	{ name: "NASA FIRMS", role: "focos de calor satelitales" },
];
---

<section id="fuentes" class="mx-auto max-w-7xl px-5 py-24 sm:px-8 lg:py-32">
	<div class="grid gap-12 lg:grid-cols-12">
		<div class="lg:col-span-4">
			<h2 class="text-3xl font-semibold sm:text-4xl">Las mismas fuentes que ya consultas, en un solo lugar</h2>
			<p class="mt-5 max-w-sm text-muted-foreground">
				No inventamos pronósticos. Leemos lo que publican las entidades
				oficiales, lo georreferenciamos y lo cruzamos con tu red.
			</p>
		</div>
		<ul class="grid gap-x-10 gap-y-5 sm:grid-cols-2 lg:col-span-8 lg:col-start-5">
			{
				sources.map((source) => (
					<li class="border-t border-border pt-3">
						<span class="font-medium">{source.name}</span>
						<span class="block text-sm text-muted-foreground">{source.role}</span>
					</li>
				))
			}
		</ul>
	</div>
</section>
