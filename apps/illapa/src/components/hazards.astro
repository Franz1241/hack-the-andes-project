---
interface Hazard {
	name: string;
	description: string;
	regions: string;
	season: string;
}

const hazards: Hazard[] = [
	{
		name: "Lluvias intensas y El Niño costero",
		description:
			"Avisos meteorológicos por nivel, caudal de ríos y el comunicado quincenal del ENFEN, para que el cambio de fase no te tome con la flota en la costa norte.",
		regions: "Tumbes, Piura, Lambayeque, La Libertad, Áncash",
		season: "Diciembre a abril",
	},
	{
		name: "Huaicos y deslizamientos",
		description:
			"Quebradas activadas, cierres y restricciones de Provías y Sutran en las vías de penetración a la sierra.",
		regions: "Carretera Central, Lima este, Arequipa, Cusco",
		season: "Enero a marzo",
	},
	{
		name: "Heladas y friaje",
		description:
			"Descensos de temperatura por debajo del umbral en los pasos de altura y el ingreso de frentes fríos a la selva.",
		regions: "Puno, Cusco, Arequipa alta, Madre de Dios, Ucayali",
		season: "Mayo a septiembre",
	},
	{
		name: "Incendios forestales",
		description:
			"Focos de calor detectados por satélite, agrupados por distrito, con la dirección del viento prevista.",
		regions: "Cusco, Madre de Dios, Ucayali, Cajamarca, Amazonas",
		season: "Agosto a octubre",
	},
	{
		name: "Bloqueos, paros y protestas",
		description:
			"Convocatorias anunciadas y bloqueos confirmados en carretera, con el punto exacto y la ventana horaria.",
		regions: "Corredor minero sur, Panamericana Sur, Puno y Juliaca",
		season: "Todo el año",
	},
	{
		name: "Oleaje anómalo y cierre de puertos",
		description:
			"Avisos de la Dirección de Hidrografía y los cierres de puerto que retrasan la carga de exportación.",
		regions: "Paita, Callao, Pisco, Matarani, Ilo",
		season: "Todo el año, más frecuente de mayo a septiembre",
	},
];
---

<section id="vigilancia" aria-labelledby="vigilancia-title" class="border-t border-border">
	<div class="mx-auto grid max-w-7xl gap-12 px-5 py-24 sm:px-8 lg:grid-cols-12 lg:py-32">
		<header class="flex flex-col gap-5 lg:col-span-4">
			<p class="type-label text-muted-foreground">Vigilancia · Perú</p>
			<h2 id="vigilancia-title" class="type-title">Seis cosas que cortan una ruta en el Perú</h2>
			<p class="type-lead text-muted-foreground">Cada una tiene su temporada, sus regiones y su fuente oficial. ILLAPA las sigue a todas y te muestra solo las que tocan tu operación.</p>
		</header>
		<dl class="flex min-w-0 flex-col gap-4 lg:col-span-8">
			{hazards.map((hazard) => (
				<div class="grid gap-5 rounded-lg border border-border bg-card p-6 sm:grid-cols-[minmax(0,1fr)_12rem] sm:gap-8">
					<div>
						<dt class="type-heading">{hazard.name}</dt>
						<dd class="type-body mt-3 max-w-prose text-muted-foreground">{hazard.description}</dd>
					</div>
					<dd class="flex flex-col gap-3">
						<p class="type-body text-muted-foreground">{hazard.regions}</p>
						<p class="type-data">{hazard.season}</p>
					</dd>
				</div>
			))}
		</dl>
	</div>
</section>
