---
import { badgeVariants } from "@hack-the-andes-project/ui/components/badge";
import { buttonVariants } from "@hack-the-andes-project/ui/components/button";
import DemoRequestDialog from "@hack-the-andes-project/ui/components/demo-request-dialog";
import {
	CONTACT_PHONE_DISPLAY,
	CONTACT_PHONE_E164,
	DEMO_REQUESTS_PATH,
	HERO_CORRIDOR_COUNT,
} from "@/constants";
import { ENV } from "@/env.public";
import { HERO_FEED, HERO_HAZARD_STATES } from "@/hero-data";
import HeroMap from "./hero-map";
---

<section class="relative min-h-svh overflow-hidden border-b border-border bg-background text-foreground" aria-labelledby="hero-title">
	<div class="absolute inset-0 lg:left-1/4">
		<HeroMap client:only="react" />
	</div>
	<div
		class="pointer-events-none absolute inset-y-0 left-0 w-full bg-linear-to-r from-background via-background/95 to-background/60 sm:w-4/5 sm:to-background/0 lg:w-3/5"
		aria-hidden="true"
	>
	</div>

	<div
		class="pointer-events-none relative mx-auto grid min-h-svh max-w-7xl grid-rows-[1fr_auto] gap-10 px-5 pt-28 pb-10 sm:px-8 lg:grid-cols-12 lg:grid-rows-1 lg:items-end lg:pb-16"
	>
		<div class="pointer-events-auto max-w-xl self-center lg:col-span-6">
			<h1 id="hero-title" class="type-display">
				Despacha sabiendo qué pasa en la ruta.
			</h1>
			<p class="type-lead mt-6 max-w-md text-muted-foreground">
				Illapa reúne las alertas de lluvias, huaicos, heladas, incendios y
				bloqueos del Perú, las cruza con tu red de corredores y te avisa qué
				tramos se ven afectados y por cuánto tiempo.
			</p>
			<div class="mt-8 flex flex-wrap items-center gap-3">
				<DemoRequestDialog
					client:load
					endpoint={DEMO_REQUESTS_PATH}
					contactPhone={CONTACT_PHONE_E164}
					contactPhoneDisplay={CONTACT_PHONE_DISPLAY}
				/>
				<a
					href={`${ENV.PUBLIC_APP_URL}/login`}
					class={buttonVariants({ variant: "link", size: "lg" })}
				>
					Ya tengo cuenta
				</a>
			</div>
			<p class="type-body mt-10 text-muted-foreground">
				Hecho para operaciones de carga en el Perú, con datos del SENAMHI,
				ENFEN, INDECI, Provías y la NASA.
			</p>
		</div>

		<aside
			aria-label="Alertas recientes de ejemplo"
			class="pointer-events-auto w-full max-w-sm justify-self-start border border-border bg-card text-card-foreground lg:col-span-5 lg:col-start-8 lg:justify-self-end"
		>
			<div class="flex items-baseline justify-between gap-3 border-b border-border px-5 py-3">
				<h2 class="type-label">Tu red, hoy</h2>
				<span class="type-data text-muted-foreground">{HERO_CORRIDOR_COUNT} corredores</span>
			</div>
			<ol class="divide-y divide-border">
				{
					HERO_FEED.map((entry) => (
						<li class="grid grid-cols-[auto_1fr] gap-x-3 px-5 py-3">
							<span class="mt-1.5 flex items-start">
								<span aria-hidden="true" class:list={["size-2 rounded-full", HERO_HAZARD_STATES[entry.state].dotClassName]} />
							</span>
							<div>
								<div class="flex items-baseline justify-between gap-3">
									<span class="type-label">{entry.corridor}</span>
									<span class="type-data shrink-0 text-muted-foreground">{entry.time}</span>
								</div>
								<p class="type-body mt-2 text-muted-foreground">{entry.message}</p>
								<div class="mt-3">
									<span class={badgeVariants({ variant: HERO_HAZARD_STATES[entry.state].variant })}>{HERO_HAZARD_STATES[entry.state].label}</span>
								</div>
							</div>
						</li>
					))
				}
			</ol>
		</aside>
	</div>
</section>
