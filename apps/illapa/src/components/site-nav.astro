---
import { ENV } from "@/env.public";
---

<header class="absolute inset-x-0 top-0 z-20">
	<nav
		aria-label="Principal"
		class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-5 sm:px-8"
	>
		<a href="/" class="font-heading text-xl font-semibold tracking-tight">
			Illapa
		</a>
		<div class="hidden items-center gap-8 text-sm md:flex">
			<a href="#vigilancia" class="hover:underline underline-offset-4">Qué vigilamos</a>
			<a href="#como-funciona" class="hover:underline underline-offset-4">Cómo funciona</a>
			<a href="#fuentes" class="hover:underline underline-offset-4">Fuentes</a>
		</div>
		<a
			href={`${ENV.PUBLIC_APP_URL}/login`}
			class="inline-flex h-9 items-center border border-foreground px-4 text-sm font-medium hover:bg-foreground hover:text-background"
		>
			Entrar
		</a>
	</nav>
</header>
