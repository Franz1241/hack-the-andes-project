{
	"name": "@hack-the-andes-project/infra",
	"private": true,
	"type": "module",
	"scripts": {
		"check-types": "tsc --noEmit",
		"dev": "alchemy dev --profile cloudflare-franz",
		"plan": "APP_ENV=production alchemy plan --stage prod --profile cloudflare-franz",
		"deploy": "APP_ENV=production alchemy deploy --stage prod --profile cloudflare-franz --yes",
		"deploy:server": "APP_ENV=production alchemy deploy --stage prod --profile cloudflare-franz --yes --include server",
		"deploy:web": "APP_ENV=production alchemy deploy --stage prod --profile cloudflare-franz --yes --include web",
		"deploy:illapa": "APP_ENV=production alchemy deploy --stage prod --profile cloudflare-franz --yes --include illapa",
		"destroy": "APP_ENV=production alchemy destroy --stage prod --profile cloudflare-franz",
		"logs:server": "alchemy logs --stage prod --profile cloudflare-franz --resource server --tail",
		"logs:web": "alchemy logs --stage prod --profile cloudflare-franz --resource web --tail",
		"logs:illapa": "alchemy logs --stage prod --profile cloudflare-franz --resource illapa --tail",
		"login": "alchemy profile edit --profile cloudflare-franz",
		"refresh": "alchemy profile refresh --profile cloudflare-franz"
	},
	"devDependencies": {
		"@effect/platform-bun": "4.0.5",
		"@effect/platform-node": "4.0.5",
		"@hack-the-andes-project/config": "workspace:*",
		"alchemy": "2.0.0-beta.83",
		"effect": "4.0.5",
		"typescript": "^6.0.3",
		"varlock": "catalog:"
	}
}
