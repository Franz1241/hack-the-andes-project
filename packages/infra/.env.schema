# Loads the values alchemy's effect `Config` reads from process.env. Each
# imported app resolves its own `@currentEnv=$APP_ENV`, so APP_ENV=production
# (set by the deploy scripts) also loads their tracked `.env.production` URLs.
# @import(../../apps/server/, pick=[APP_ENV, BETTER_AUTH_SECRET, BETTER_AUTH_URL, ALLOWED_ORIGINS])
# @import(../../apps/web/, pick=[APP_ENV, VITE_SERVER_URL])
# @import(../../apps/scraper/, pick=[APP_ENV, SCRAPER_RUN_SECRET, JEV_API_KEY])
# @import(../../apps/fleet-sync/, pick=[FLEET_SYNC_RUN_SECRET])
# @import(../../packages/db/, pick=[DATABASE_URL])
# @defaultRequired=false
# @defaultSensitive=true
# ---
